# 默认只把这个仓库当作插件承载项目提交。
# 根目录除必要 Godot 项目配置和 addons 外全部忽略。
*

# Git / 编辑器仓库配置
!/.editorconfig
!/.gitattributes
!/.gitignore

# 必要 Godot 项目配置
!/project.godot
!/icon.png
!/icon.png.import

# 插件目录
!/addons/
!/addons/**

# Godot 生成目录和本机配置
/.godot/
/android/
/.vscode/
/.claude/
/.vs/

# 插件内本机/锁定/热重载产物
addons/**/.vs/
addons/**/~*
addons/**/CSharpWrappers/
